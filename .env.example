PORT=3000
SIMULATION_MODE=true
# Replace this local-only sample token before sharing or deploying.
CONTROL_TOKEN=local-dev-control-token
# Required when SIMULATION_MODE=false; pass as /robot?token=... to the ESP32.
ROBOT_TOKEN=
# Optional metadata/source configuration for a Socket.IO WebRTC camera bridge.
CAMERA_STREAM_URL=
# Vite options are read when the frontend is built.
VITE_DEMO_MODE=false
VITE_DEMO_VIDEO_URL=
# Optional JSON array of your own STUN/TURN servers, for example [{"urls":"turn:turn.example.net","username":"user","credential":"secret"}]
VITE_ICE_SERVERS=
